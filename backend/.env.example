# Local only. Real .env files are ignored by Git and excluded from images.
APP_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@HOST-DO-NEON/neondb?sslmode=verify-full&channel_binding=require"
# Data_Base is a supported alias. Configure only one URL, without DB_HOST/DB_USER/etc.
# Render: configure DATABASE_URL or Data_Base in Environment, with APP_ENV=production.
