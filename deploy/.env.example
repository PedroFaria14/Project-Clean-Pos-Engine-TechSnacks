# Copy to deploy/.env.production (ignored by Git). Never put credentials in images.
APP_DOMAIN=pos.example.com
ACME_EMAIL=operations@example.com
BACKEND_IMAGE=registry.example.com/techsnacks/backend:replace-with-tested-git-sha
FRONTEND_IMAGE=registry.example.com/techsnacks/frontend:replace-with-tested-git-sha
DB_HOST=database.example.com
DB_PORT=5432
DB_NAME=techsnacks
DB_USER=techsnacks_app
DB_PASSWORD_FILE=/srv/techsnacks/secrets/db-password
DB_SSLROOTCERT_FILE=/srv/techsnacks/secrets/db-ca.pem
MIGRATION_DB_USER=techsnacks_migrator
MIGRATION_DB_PASSWORD_FILE=/srv/techsnacks/secrets/db-administrative-password
